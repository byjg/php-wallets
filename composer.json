{
  "name": "byjg/wallets",
  "description": "A robust PHP library for managing digital wallets and financial transactions with full audit trails, transaction chain integrity, and support for reserved funds.",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "require": {
    "ext-pdo": "*",
    "ext-openssl": "*",
    "php": ">=8.3 <8.7",
    "byjg/micro-orm": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "ByJG\\Wallets\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "byjg/migration": "^7.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  }
}
